/*
 * SPI1 is pre-configured in nucleo_g474re.dts on PA5/PA6/PA7 with
 * cs-gpios = PB6. The ILI9488 panel is driven through a zephyr,mipi-dbi-spi
 * controller on SPI1 with PC8=RESET, PC6=DC as GPIOs.
 *
 * Pin conflicts resolved here:
 *  - green LED on PA5                  -> leds/pwmleds/timers2 disabled (PA5 = SPI1 SCK)
 *  - console/shell on lpuart1 (PA2/PA3) -> ST-LINK VCP (/dev/ttyACM0); usart1 (PC4/PC5) disabled
 *  - spi2/spi3 (PB12-15, PA15/PC10-12) disabled, their pins are not used
 *
 * Board 3V3 and 5V header rails power the panel (backlight/VIN), no DT node.
 */

#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/dma/stm32_dma.h>
#include <freq.h>

/ {
    chosen {
        zephyr,console = &lpuart1;
        zephyr,shell-uart = &lpuart1;
        zephyr,display = &ili9488_lcd;
    };

    lcd_gpios {
        compatible = "gpio-leds";
        lcd_dc: lcd_dc {
            gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
            label = "LCD_DC";
        };
        lcd_rst: lcd_rst {
            gpios = <&gpioc 8 GPIO_ACTIVE_LOW>;
            label = "LCD_RESET";
        };
        lcd_cs: lcd_cs {
            gpios = <&gpiob 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "LCD_CS";
        };
    };

    mipi_dbi: mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi1>;
        dc-gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpioc 8 GPIO_ACTIVE_LOW>;
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";

        ili9488_lcd: ili9488@0 {
            compatible = "ilitek,ili9488";
            reg = <0>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            /* 4 MHz matches the proven ili9488_diag SPI speed on this wiring. */
            mipi-max-frequency = <DT_FREQ_M(4)>;
            /* Physical GRAM is 320x480; rotation 270 => landscape 480x320
             * with MADCTL MY|MV|BGR = 0xA8 (same as ili9488_diag). */
            width = <320>;
            height = <480>;
            /* RGB_888: the ILI9488 is driven in its native 18-bit RGB666 mode
             * (COLMOD 0x66, 3 bytes/pixel), the only mode validated to render
             * correct colors on this panel through the 4-wire SPI path. */
            pixel-format = <PANEL_PIXEL_FORMAT_RGB_888>;
            rotation = <270>;
            /* LCDWIKI MSP3520 initsq16 register table (proven in ili9488_diag). */
            frmctr1 = [b0 11];
            disctrl = [02 22 3b];
            pwctrl1 = [11 09];
            pwctrl2 = [41];
            vmctrl = [00 0a 80 40];
            pgamctrl = [00 07 10 09 17 0b 41 89 4b 0a 0c 0e 18 1b 0f];
            ngamctrl = [00 17 1a 04 0e 06 2f 45 43 02 0a 09 32 36 0f];
            status = "okay";
        };
    };
};

&leds {
    status = "disabled";
};

&usart1 {
    status = "disabled";
};

/ {
    pwmleds {
        status = "disabled";
    };
};

&timers2 {
    status = "disabled";
};

&spi2 {
    status = "disabled";
};

&spi3 {
    status = "disabled";
};

/* DMA disabled for the bisection test: match ili9488_diag (no DMA). */
&dma1 {
    status = "disabled";
};

&dmamux1 {
    status = "disabled";
};
